<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppression file.

  Empty by default. security.yml's "Dependency · OWASP check" job passes
  --suppression pointing at this file; if the file doesn't exist, the scan
  fails before it produces any results at all. Keep this file present even
  with zero suppressions.

  When you do need to suppress a finding (confirmed false positive, or a
  vulnerability that's been triaged and accepted with a documented reason),
  add a <suppress> block here — never suppress silently. Example:

  <suppress>
     <notes><![CDATA[
     False positive: CVE-2023-XXXXX applies to the Java build of this
     package; we only use the Python wheel, which doesn't include the
     affected code path. Triaged 2026-07-04 by <name>.
     ]]></notes>
     <packageUrl regex="true">^pkg:pypi/example-package@.*$</packageUrl>
     <cve>CVE-2023-XXXXX</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
