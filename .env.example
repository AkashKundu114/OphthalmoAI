# ==============================================================================
# OphthalmoAI Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configurations (Multi-Backend Support)
# ------------------------------------------------------------------------------
# 1. Development (default SQLite):
DATABASE_URL=sqlite:///./ophthalmoai.db

# 2. PostgreSQL (production / multi-instance):
# DATABASE_URL=postgresql://ophthalmo:password@localhost:5432/ophthalmoai

# 3. MS SQL Server (enterprise hospital networks / EHR integration):
# DATABASE_URL=mssql+pyodbc://sa:password@localhost/ophthalmoai?driver=ODBC+Driver+18+for+SQL+Server

# Optional: Override async DB path if different from auto-derived URL
# ASYNC_DATABASE_URL=postgresql+asyncpg://ophthalmo:password@localhost:5432/ophthalmoai

# ------------------------------------------------------------------------------
# Runtime & Server
# ------------------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
FORCE_CPU=false
MODELS_DIR=./models
PERSIST_SCANS=true
MAX_FILE_SIZE_BYTES=20971520

# ------------------------------------------------------------------------------
# Security, Auth & Tenancy
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION_DEPLOYMENT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false

# Rate limiting
PREDICT_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=30/minute
AUTH_RATE_LIMIT=20/minute

# ------------------------------------------------------------------------------
# AI Models & Clinical Assistance
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Sarvam AI (Indian regional languages STT / TTS)
SARVAM_API_KEY=

# Ollama local inference
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b

# Clinical risk & quality gates
MC_DROPOUT_PASSES=8
ENABLE_UNCERTAINTY=true
ENABLE_IQA=true
MODEL_REGISTRY_JSON=./models/registry.json

# ------------------------------------------------------------------------------
# Cloud Storage & KMS (Optional)
# ------------------------------------------------------------------------------
SCAN_STORAGE_BUCKET=
SCAN_STORAGE_KMS_KEY_ID=
AWS_REGION=us-east-1
