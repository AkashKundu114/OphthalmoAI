# High-performance PyTorch container with NVIDIA CUDA support
FROM pytorch/pytorch:latest

WORKDIR /workspace/app

# Upgrade PyTorch and torchvision with CUDA 12.8 nightly supporting Blackwell (sm_120)
RUN pip install --no-cache-dir --pre --upgrade torch --index-url https://download.pytorch.org/whl/nightly/cu128
RUN pip uninstall -y torchvision && pip install --no-cache-dir --pre --no-deps torchvision --index-url https://download.pytorch.org/whl/nightly/cu128

# Install dependencies required for training, benchmarking, and telemetry
RUN pip install --no-cache-dir \
    pandas \
    scikit-learn \
    tqdm \
    pillow \
    scipy \
    tabulate \
    pynvml \
    psutil

# Copy code scripts
COPY scripts/ ./scripts/

# Default entrypoint runs training with CUDA GPU acceleration
CMD ["python", "scripts/train_ensemble.py", "--device", "cuda", "--precision", "fp16", "--batch-size", "32"]
